# Ignore anything generated, local to this machine, or private to a user.
#
# The rule that matters most: the application's database, uploads, avatars, keys
# and audit log must never be committed -- they hold real accounts and real
# messages. As a desktop build that data lives in %APPDATA%\FatFish, but a source
# checkout writes it next to the sources, so both shapes are excluded below.

# ── Python ───────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
packaging/build/
packaging/dist/

# ── Local application data (accounts, messages, uploads, keys) ───────────────
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
secret.key
*.pem
audit.log
audit.log.rotated_at
/minimost/auth.db
/minimost/presence.db
/minimost/users/
/minimost/uploads/
/minimost/avatars/
/minimost/stickers/

# ── Verification scratch ────────────────────────────────────────────────────
# run_tests_local.py and the verify_*.py scripts build throwaway databases here.
.test-scratch/
.test-scratch-run/
.pytest-*/
.verify*/
.packtest/
.devdata/
.render-smoke/
.verify-registry/
.asar-stage/
.upgrade-backup/
.setuptemp/
upgrade-test/
/insttest*/
/cmpfresh/
.acl-recovery/

# ── Node / desktop build ────────────────────────────────────────────────────
node_modules/
.npm-cache/
.electron-cache/
desktop/release/
desktop/.render-smoke/
desktop/node_modules/
*.log

# Generated desktop interface bundle. It is produced by `cd desktop && npm run
# build`; keeping it out of version control means a stale bundle can never be
# mistaken for source. The directory itself is kept by its README.
/minimost/src/minimost/desktop_ui/assets/
/minimost/src/minimost/desktop_ui/index.html
/minimost/src/minimost/desktop_ui/logo.svg
/minimost/src/minimost/desktop_ui/.write-probe

# ── Android client ─────────────────────────────────────────────────────────
# Toolchain and scratch downloads stay local. The signed sideload APK is kept
# as a release artifact; screenshots and app sources are tracked too.
.android-toolchain/
.android-repository.xml
.tools/
.tsnet-check*/
.tsnet-final/
安卓端/.build/
安卓端/build/
安卓端/libs/
安卓端/dist/
!安卓端/dist/
!安卓端/dist/*.apk
安卓端/keystore/
安卓端/.testdata/

# Generated icons (packaging/make_assets.py draws them from code).
desktop/build/icon.ico
desktop/build/icon.png
desktop/build/icon-256.png
packaging/minimost-server.ico

# ── Editors / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Leftover from repacking the Electron asar during a hot patch.
.app.asar
.app.asar.old

# Downloaded copy used only to compare hashes with a release asset.
.dlcheck/


# Scratch file for a multi-line commit message.
.commitmsg


# Local screenshot used when reporting the app's state.
.app-window.png


# Go toolchain and module caches used to build the tsnet sidecar, plus its binary.
# The binary is built from source in tsnet-sidecar/ and shipped inside the
# installer, so it does not belong in git.
.tools/
tsnet-sidecar/tsnet-sidecar.exe
tsnet-sidecar/tsnet-sidecar

# Manual test state of the tsnet sidecar: contains the node's private key.
.tsnet-check/


# Icon concept previews and the pre-patch exe kept for rollback.
.icon-preview/
.backup-FatFish.exe


# The app icon lives in desktop/build/, which the generic build/ rule ignores.
# It is a source asset, not a build artifact, so re-include it.
!desktop/build/
!desktop/build/*.ico
!desktop/build/*.png
!desktop/build/*.py

