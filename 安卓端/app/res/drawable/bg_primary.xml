<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#2B9FE0" android:endColor="#1D7DB5" android:angle="270" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#63D2FF" android:endColor="#2B9FE0" android:angle="270" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
